{
 "titulo": "A LAS 3:33 TODOS DEBEN ESTAR DORMIDOS!",
 "voz": {"voice_id": "moss_audio_ebf2f8a2-b928-11f1-8f51-7270dd4a9232", "speed": 1.0},
 "claves": [],
 "lineas": [
  {"id": "l01", "escena": "reloj", "texto": "En este pueblo, a las 3:33 de la mañana, todos deben estar dormidos.", "clave": ["3:33", "dormidos."], "golpe": "3:33", "sfx": [{"s": "campana", "palabra": "3:33"}]},
  {"id": "l02", "escena": "casas", "tensa": true, "texto": "Porque a esa hora algo pasa casa por casa, abriendo las puertas de los cuartos.", "clave": ["algo", "puertas"], "sfx": [{"s": "crujido", "palabra": "abriendo"}]},
  {"id": "l03", "escena": "acuesta", "texto": "Por eso aquí la gente se acuesta a las 8.", "clave": ["8."], "sfx": [{"s": "plop", "palabra": "acuesta"}]},
  {"id": "l04", "escena": "guardias", "texto": "Los guardias de noche duermen parados, como caballos.", "clave": ["guardias", "caballos."], "sfx": [{"s": "boing", "palabra": "caballos."}]},
  {"id": "l05", "escena": "panadero", "texto": "El panadero amasa sonámbulo.", "clave": ["sonámbulo."], "sfx": [{"s": "plop", "palabra": "amasa"}]},
  {"id": "l06", "escena": "bebes", "texto": "Y los bebés no lloran, porque ya aprendieron.", "clave": ["bebés", "aprendieron."], "sfx": [{"s": "pop", "palabra": "aprendieron."}]},
  {"id": "l07", "escena": "huellas", "texto": "En la mañana solo quedan huellas enormes en el jardín y las cobijas… bien estiraditas.", "clave": ["huellas", "enormes"], "golpe": "huellas", "sfx": [{"s": "pasos", "palabra": "huellas"}]},
  {"id": "l08", "escena": "mudanza", "texto": "Nos mudamos un lunes y nadie nos avisó.", "clave": ["lunes"], "sfx": [{"s": "bocina", "palabra": "mudamos"}]},
  {"id": "l09", "escena": "mia", "texto": "Yo me llamo Mía, y siempre me cuesta dormir.", "clave": ["Mía,", "dormir."]},
  {"id": "l10", "escena": "cuarto330", "tensa": true, "texto": "La primera noche, a las 3:30, seguía con los ojos abiertos.", "clave": ["3:30,", "abiertos."]},
  {"id": "l11", "escena": "puerta", "tensa": true, "texto": "3:33. La puerta se abrió despacio.", "clave": ["3:33.", "puerta"], "golpe": "3:33.", "sfx": [{"s": "campana", "palabra": "3:33."}, {"s": "crujido", "palabra": "abrió"}]},
  {"id": "l12", "escena": "silueta", "tensa": true, "texto": "Algo altísimo entró agachándose. Tenía unos brazos larguísimos.", "clave": ["altísimo", "larguísimos."], "golpe": "altísimo", "sfx": [{"s": "pasos", "palabra": "entró"}]},
  {"id": "l13", "escena": "dormida", "tensa": true, "texto": "Cerré los ojos y me hice la dormida.", "clave": ["dormida."]},
  {"id": "l14", "escena": "temblando", "tensa": true, "texto": "Sentí que se acercaba… y que me agarraba de los pies.", "clave": ["acercaba…", "pies."], "golpe": "pies.", "sfx": [{"s": "pasitos", "palabra": "acercaba…"}]},
  {"id": "l15", "escena": "tapa", "texto": "Y me tapó los pies con la cobija.", "clave": ["cobija."], "sfx": [{"s": "pop", "palabra": "tapó"}]},
  {"id": "l16", "escena": "sigue", "tensa": true, "texto": "La noche siguiente lo seguí.", "clave": ["seguí."], "sfx": [{"s": "pasitos", "palabra": "seguí."}]},
  {"id": "l17", "escena": "ventanas", "texto": "Iba casa por casa arropando niños, devolviendo peluches y apagando luces que alguien había dejado prendidas.", "clave": ["arropando", "peluches", "luces"], "sfx": [{"s": "pop", "palabra": "peluches"}, {"s": "plop", "palabra": "apagando"}]},
  {"id": "l18", "escena": "ultima", "tensa": true, "texto": "En la última casa había un niño solo, sin cobija. Sus papás trabajaban de noche.", "clave": ["solo,", "noche."]},
  {"id": "l19", "escena": "bufanda", "texto": "La criatura se quitó su propia bufanda y se la puso encima.", "clave": ["bufanda"], "sfx": [{"s": "pop", "palabra": "encima."}]},
  {"id": "l20", "escena": "mevio", "tensa": true, "texto": "Entonces me vio.", "clave": ["vio."], "golpe": "vio.", "sfx": [{"s": "boing", "palabra": "vio."}]},
  {"id": "l21", "escena": "dialogo", "habla": "nina", "quien": "mia", "tensa": true, "texto": "—¿Por qué nadie puede verte?", "clave": ["verte?"]},
  {"id": "l22", "escena": "dialogo", "habla": "criatura", "quien": "criatura", "tensa": true, "texto": "—Porque si me ven… dejo de existir.", "clave": ["existir."]},
  {"id": "l23", "escena": "bruno", "tensa": true, "texto": "En ese momento apareció Don Bruno con una linterna y una red.", "clave": ["Bruno", "linterna", "red."], "golpe": "Bruno", "sfx": [{"s": "pasos", "palabra": "apareció"}]},
  {"id": "l24", "escena": "bruno", "habla": "bruno", "quien": "bruno", "tensa": true, "texto": "—¡Por fin te atrapé, monstruo!", "clave": ["monstruo!"]},
  {"id": "l25", "escena": "apaga", "texto": "Le apagué la linterna. Nadie lo vio. Se fue.", "clave": ["apagué", "fue."], "golpe": "apagué", "sfx": [{"s": "clic", "palabra": "apagué"}, {"s": "pasitos", "palabra": "fue."}]},
  {"id": "l26", "escena": "clase", "texto": "Ahora, a las 3:33, yo también me hago la dormida.", "clave": ["3:33,", "dormida."], "sfx": [{"s": "campanas", "palabra": "Ahora,"}]},
  {"id": "l27", "escena": "clase", "texto": "Y siempre amanezco bien tapada.", "clave": ["tapada."]},
  {"id": "l28", "escena": "cta", "texto": "Y esta noche a las 3:33 va a revisar si te suscribiste.", "clave": ["3:33", "suscribiste."], "sfx": [{"s": "pop", "palabra": "revisar"}, {"s": "boing", "palabra": "suscribiste."}]}
 ]
}
