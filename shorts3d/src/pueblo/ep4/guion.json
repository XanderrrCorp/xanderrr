{
 "titulo": "SI MIENTES, TODO EL PUEBLO LO ESCUCHA!",
 "voz": {"voice_id": "moss_audio_ebf2f8a2-b928-11f1-8f51-7270dd4a9232", "speed": 0.96},
 "claves": ["MENTIRA.", "MENTIRA"],
 "lineas": [
  {"id": "l01", "escena": "postes", "texto": "En este pueblo, si dices una mentira, todo el pueblo la escucha por los altavoces.", "clave": ["mentira,", "altavoces."], "golpe": "altavoces.", "sfx": [{"s": "altavoz", "palabra": "altavoces."}]},
  {"id": "l02", "escena": "tarea", "texto": "\"Ya hice la tarea.\" → MENTIRA.", "golpe": "MENTIRA.", "sfx": [{"s": "altavoz", "palabra": "MENTIRA."}]},
  {"id": "l03", "escena": "sueter", "texto": "\"Me encanta tu suéter, abuela.\" → MENTIRA.", "golpe": "MENTIRA.", "sfx": [{"s": "altavoz", "palabra": "MENTIRA."}]},
  {"id": "l04", "escena": "galleta", "texto": "\"Solo me comí una galleta.\" → MENTIRA.", "golpe": "MENTIRA.", "sfx": [{"s": "altavoz", "palabra": "MENTIRA."}]},
  {"id": "l05", "escena": "mmm", "texto": "Por eso aquí la gente responde \"mmm\" a todo.", "clave": ["\"mmm\""]},
  {"id": "l06", "escena": "espejo", "texto": "Y nadie pregunta \"¿me veo bien?\".", "clave": ["bien?\"."]},
  {"id": "l07", "escena": "mudanza", "texto": "Nos mudamos un lunes y nadie nos avisó.", "clave": ["lunes"], "sfx": [{"s": "bocina", "palabra": "mudamos"}]},
  {"id": "l08", "escena": "sofi", "texto": "Me llamo Sofi. Mi mejor amiga aquí era Ana.", "clave": ["Sofi.", "Ana."]},
  {"id": "l09", "escena": "ana", "texto": "Ana siempre llegaba con moretones.", "clave": ["moretones."]},
  {"id": "l10", "escena": "ana", "habla": "nina", "quien": "ana", "texto": "—Me caí de la bici.", "clave": ["bici."]},
  {"id": "l11", "escena": "silencio", "tensa": true, "texto": "Y el altavoz no sonaba.", "clave": ["no", "sonaba."]},
  {"id": "l12", "escena": "confusa", "texto": "Era verdad… pero se caía de la bici todos los días.", "clave": ["verdad…", "días."]},
  {"id": "l13", "escena": "noche", "tensa": true, "texto": "Una noche la vi por la ventana: practicaba sola, a oscuras, cayéndose una y otra vez.", "clave": ["sola,", "otra", "vez."], "sfx": [{"s": "plop", "palabra": "cayéndose"}]},
  {"id": "l14", "escena": "charla", "habla": "nina", "quien": "sofi", "tensa": true, "texto": "—¿Por qué entrenas de noche?", "clave": ["noche?"]},
  {"id": "l15", "escena": "charla", "habla": "nina", "quien": "ana", "tensa": true, "texto": "—Porque en la carrera del sábado, el que gana le pide un deseo al alcalde.", "clave": ["deseo"]},
  {"id": "l16", "escena": "charla", "habla": "nina", "quien": "sofi", "tensa": true, "texto": "—¿Y qué vas a pedir?", "clave": ["pedir?"]},
  {"id": "l17", "escena": "charla", "habla": "nina", "quien": "ana", "tensa": true, "texto": "—Que apaguen los altavoces.", "clave": ["altavoces."], "golpe": "altavoces."},
  {"id": "l18", "escena": "flashback", "tensa": true, "texto": "Hace años, Ana dijo: \"Mi papá vuelve pronto\". Y el pueblo entero escuchó: MENTIRA.", "clave": ["papá", "MENTIRA."], "golpe": "MENTIRA.", "sfx": [{"s": "altavoz", "palabra": "MENTIRA."}]},
  {"id": "l19", "escena": "carrera", "texto": "El sábado Ana iba ganando… pero se cayó en la última curva.", "clave": ["ganando…", "cayó"], "golpe": "cayó", "sfx": [{"s": "campanas", "palabra": "sábado"}, {"s": "plop", "palabra": "cayó"}]},
  {"id": "l20", "escena": "copa", "texto": "Don Bruno le dio la copa a otro niño.", "clave": ["copa", "otro"], "sfx": [{"s": "campana", "palabra": "copa"}]},
  {"id": "l21", "escena": "escenario", "texto": "Entonces subí al escenario y dije:", "clave": ["escenario"], "sfx": [{"s": "pasos", "palabra": "subí"}]},
  {"id": "l22", "escena": "escenario", "habla": "nina", "quien": "sofi", "texto": "—¡Ana ganó!", "clave": ["ganó!"], "golpe": "ganó!"},
  {"id": "l23", "escena": "callados", "tensa": true, "texto": "Silencio. Ningún altavoz sonó.", "clave": ["Silencio.", "Ningún"]},
  {"id": "l24", "escena": "bruno", "habla": "bruno", "quien": "bruno", "tensa": true, "texto": "—Esa niña… dice la verdad.", "clave": ["verdad."], "golpe": "verdad."},
  {"id": "l25", "escena": "senala", "habla": "nina", "quien": "sofi", "texto": "—¡Porque ganar no es llegar primero! ¡Es no dejar de levantarse!", "clave": ["primero!", "levantarse!"]},
  {"id": "l26", "escena": "chispas", "texto": "Los altavoces se apagaron solos, uno por uno.", "clave": ["apagaron"], "sfx": [{"s": "chispa", "palabra": "apagaron"}, {"s": "chispa", "palabra": "uno"}, {"s": "chispa", "palabra": "uno."}]},
  {"id": "l27", "escena": "abrazo", "texto": "Ahora en el pueblo la gente puede equivocarse.", "clave": ["equivocarse."], "sfx": [{"s": "pop", "palabra": "Ahora"}]},
  {"id": "l28", "escena": "abrazo", "texto": "Pero Ana y yo nunca nos mentimos.", "clave": ["nunca"]},
  {"id": "l29", "escena": "cta", "texto": "Y si dices que ya te suscribiste… los altavoces te van a delatar.", "clave": ["suscribiste…", "delatar."], "sfx": [{"s": "altavoz", "palabra": "delatar."}]}
 ]
}
