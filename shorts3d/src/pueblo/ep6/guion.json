{
 "titulo": "SI ROMPES ALGO, APARECE EN TU CAMA!",
 "voz": {"voice_id": "moss_audio_ebf2f8a2-b928-11f1-8f51-7270dd4a9232", "speed": 0.96},
 "claves": [],
 "lineas": [
  {"id": "l01", "escena": "plato", "texto": "En este pueblo, si rompes algo, a la mañana siguiente aparece en tu cama.", "clave": ["rompes", "cama."], "golpe": "cama.", "sfx": [{"s": "crujido", "palabra": "rompes"}, {"s": "boing", "palabra": "cama."}]},
  {"id": "l02", "escena": "vidrios", "texto": "Un señor rompió una ventana y amaneció lleno de vidrios.", "clave": ["vidrios."], "sfx": [{"s": "crujido", "palabra": "vidrios."}]},
  {"id": "l03", "escena": "carro", "texto": "El que chocó el carro amaneció con el carro encima.", "clave": ["carro", "encima."], "golpe": "encima.", "sfx": [{"s": "bocina", "palabra": "chocó"}, {"s": "plop", "palabra": "encima."}]},
  {"id": "l04", "escena": "pinata", "texto": "El que rompió la piñata, lleno de dulces. A ese le fue bien.", "clave": ["piñata,", "dulces."], "sfx": [{"s": "pop", "palabra": "dulces."}, {"s": "boing", "palabra": "bien."}]},
  {"id": "l05", "escena": "despacito", "texto": "Por eso aquí todos caminan despacito.", "clave": ["despacito."], "sfx": [{"s": "pasitos", "palabra": "caminan"}]},
  {"id": "l06", "escena": "futbol", "texto": "Y nadie juega fútbol cerca de las casas.", "clave": ["fútbol"], "sfx": [{"s": "boing", "palabra": "fútbol"}]},
  {"id": "l07", "escena": "mudanza", "texto": "Nos mudamos un lunes y nadie nos avisó.", "clave": ["lunes"], "sfx": [{"s": "bocina", "palabra": "mudamos"}]},
  {"id": "l08", "escena": "florero", "texto": "Me llamo Leo. El primer día rompí el florero de mamá.", "clave": ["Leo.", "florero"], "golpe": "rompí", "sfx": [{"s": "crujido", "palabra": "rompí"}]},
  {"id": "l09", "escena": "tierra", "texto": "Amanecí lleno de tierra.", "clave": ["tierra."], "sfx": [{"s": "plop", "palabra": "tierra."}]},
  {"id": "l10", "escena": "amigos", "texto": "En la escuela conocí a Dani. Nos hicimos mejores amigos en un día.", "clave": ["Dani.", "amigos"], "sfx": [{"s": "campana", "palabra": "escuela"}]},
  {"id": "l11", "escena": "secreto", "texto": "Pero una semana después, le conté su secreto a toda la clase.", "clave": ["secreto"], "golpe": "secreto"},
  {"id": "l12", "escena": "seva", "tensa": true, "texto": "Dani dejó de hablarme.", "clave": ["hablarme."]},
  {"id": "l13", "escena": "dormir", "tensa": true, "texto": "Esa noche me dormí pensando que no había roto nada.", "clave": ["nada."]},
  {"id": "l14", "escena": "pie", "tensa": true, "texto": "Y al despertar… Dani estaba sentado al pie de mi cama.", "clave": ["Dani", "cama."], "golpe": "Dani", "sfx": [{"s": "boing", "palabra": "Dani"}]},
  {"id": "l15", "escena": "pie", "habla": "nino", "quien": "leo", "tensa": true, "texto": "—¿Qué haces aquí?", "clave": ["aquí?"]},
  {"id": "l16", "escena": "pie", "habla": "nino", "quien": "dani", "tensa": true, "texto": "—No sé. Me desperté aquí.", "clave": ["aquí."]},
  {"id": "l17", "escena": "entiende", "tensa": true, "texto": "Entonces entendí: había roto algo. Nuestra amistad.", "clave": ["roto", "amistad."], "golpe": "amistad."},
  {"id": "l18", "escena": "arreglar", "texto": "Intenté arreglarlo. Pegamento, cinta, una carta. Nada.", "clave": ["Pegamento,", "cinta,", "carta.", "Nada."], "sfx": [{"s": "plop", "palabra": "Pegamento,"}, {"s": "cinta", "palabra": "cinta,"}, {"s": "pop", "palabra": "carta."}]},
  {"id": "l19", "escena": "pie2", "tensa": true, "texto": "Cada mañana, Dani aparecía otra vez al pie de mi cama.", "clave": ["otra", "vez"]},
  {"id": "l20", "escena": "brunoCasa", "texto": "La casa de Don Bruno estaba llena de cosas rotas hasta el techo.", "clave": ["Bruno", "rotas"], "golpe": "techo."},
  {"id": "l21", "escena": "hermano", "tensa": true, "texto": "Y en su cama dormía su hermano, que no le hablaba desde hacía 30 años.", "clave": ["hermano,", "30"]},
  {"id": "l22", "escena": "plaza", "texto": "Así que hice lo único que no había intentado.", "clave": ["único"]},
  {"id": "l23", "escena": "plaza", "habla": "nino", "quien": "leo", "texto": "—Perdón. Lo hice para que se rieran de mí, no de ti.", "clave": ["Perdón."]},
  {"id": "l24", "escena": "puerta", "texto": "Pop. Esa mañana desperté solo en mi cama. Dani estaba en la puerta, con un balón.", "clave": ["Pop.", "solo", "balón."], "golpe": "Pop.", "sfx": [{"s": "pop", "palabra": "Pop."}, {"s": "boing", "palabra": "balón."}]},
  {"id": "l25", "escena": "perdon", "texto": "Don Bruno lo vio todo. Esa tarde, por fin, le pidió perdón a su hermano.", "clave": ["perdón", "hermano."]},
  {"id": "l26", "escena": "vacia", "texto": "Y su casa se vació en un segundo.", "clave": ["segundo."], "golpe": "segundo.", "sfx": [{"s": "pop", "palabra": "vació"}, {"s": "pop", "palabra": "segundo."}]},
  {"id": "l27", "escena": "cta", "texto": "Y si no te suscribes, mañana vas a amanecer con este video en tu cama.", "clave": ["suscribes,", "cama."], "sfx": [{"s": "boing", "palabra": "cama."}]}
 ]
}
